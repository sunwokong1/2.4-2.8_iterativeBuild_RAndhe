     }
   
        /* Page 2/3 Divs */
        
       
        
        
        
        ul {
        display: inline;
        padding: 0px 0px 0px 0px;
        list-style: none;
        }
        /* Navigation Bar Style  */
        
        ul li {
        font-family: Arial;
        font-size: 23px;
        font-weight: bold;
        display: inline-block;
        margin-right: -4px;
        position: relative;
        left: 19px;
        top: 13px;
        padding: 13px 35px 10px;
        border-radius: 20px;
        color: white;
        }
        ul li:hover {
        background: #343434; /* Drop down menu hover colour */
          }
         
        a:link {color:#FFFFFF;}
        a:visited {color:#FFFFFF;}
        a:hover {color:#FFFFFF;}
        a:active {color:#FFFFFF;}  
        
        /* Drop down Menu Style  */
        
        ul li ul {
        padding: 0px;
        position: absolute;
        top: 40px;
        left: -80px;
        width: 320px;
        display: none;
        z-index: 1;
        
        }
        
        ul li ul li {
        background: #454545; /* Drop down Menu colour w/o hover  */
        display: block;
        border-radius: 50px;
        }
        
        ul li:hover ul {
        display: block;
        visibility: visible; /* Drop down menu visiblity  */
        }
        


        .scroll-area {
        position: absolute;
        height: 100%;
        overflow: auto;
        }
        
        #myBtn {
        position: fixed;
        bottom: 20px; 
        right: 30px;
        z-index: 99;
        font-size: 10px;
        border: none;
        outline: none;
        color: #404040;
        cursor: pointer;
        padding: 10px; 
        background-color: #383f3d;
        border-radius: 4px;
        -moz-border-radius: 200px;
        -webkit-border-radius: 200px;
        }
        
     .footer {
  grid-column-end: span 4;
  background-color: #004166;
  padding: 6px;
  color: white;
  font-style: italic;
  font-size: 0.8rem;
  font-family: Arial, Helvetica, sans-serif;
  margin-bottom: 0;
  clear: both;
  position: relative; /* Add this line */
  bottom: 0; /* Add this line */
  width: 100%; /* Add this line */
}
        
#btn-back-to-top {
  position: fixed;
  bottom: 30px;
  right: 30px;
  width: 60px;
  height: 60px;
  background-color: rgb(0, 0, 0);
  color: white;
  border-radius: 30px;
} 
      
