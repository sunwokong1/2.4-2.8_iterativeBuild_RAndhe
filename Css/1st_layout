.grid-container {
  display: grid;
  grid-template-columns: 130px 1400 50px 150px;
  grid-template-rows: 412px 55px 450px 100px;
  overflow-x: show;
}
 
        .header {
        box-sizing: border-box;
        background-color: #ffffff; 
        grid-column-start: 1;
        grid-column-end: 3;
     
        }
    
       .banner {
        position: absolute;
        top: 0px; 
        left: 0px;
        width: 100%; 
        height: auto;
        }
        
        .top{
        width: 40%;
        background-color:#383f3d;
        }
        
        .nav-1 {
          box-sizing: border-box;
          background-color: #C92D54;
          position: relative;
          grid-column-start: 1;
          height: 21px;
          width: 2034px;
          left: -10px;
        }
        .nav-2 {
          box-sizing: border-box;
          background-color: #E8D20B;
          position: relative;
          grid-column-start: 1;
          height: 21px;
          top: -34px;
          width: 2032px;
          left: -10px;
          }
          
        .nav-3 {
          box-sizing: border-box;
          background-color: #004166;
          position: relative;
          grid-column-start: 1;
          height: 90px;
          top: -470px; 
          width: 2032px;
          left: -10px;
       
          }


         .content {
        box-sizing: border-box;
        position: relative;
        grid-column-start: 1;
        grid-column-end: span 2;
        background-color: #ffffff;
        top: -470px;
        height: 500px;
        left: -3px;
        padding-left: 7px;

        }
    
    
        h2{
          font-family: 'Open Sans', sans-serif;
